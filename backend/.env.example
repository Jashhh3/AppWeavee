# For Docker, leave these unset: backend/docker-entrypoint.sh generates and persists them in /data.
# For a non-Docker backend run only, set real local values in backend/.env (never commit it).
# JWT_SECRET=generated-locally
# AI_ENCRYPTION_KEY=generated-locally
PORT=3000
DATA_FILE=./data/appweave.json
# Optional durable persistence. Docker Compose supplies this automatically.
# DATABASE_URL=postgresql://appweave:appweave-local-only@localhost:5432/appweave
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
PROJECT_WORKSPACE_ROOT=./data/projects
SESSION_COOKIE_NAME=appweave_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_MAX_AGE=604800
AI_PROVIDER_TIMEOUT_MS=60000
# Temporary external testing only. Never commit a real ngrok token.
# NGROK_AUTHTOKEN=replace-me
# NGROK_DOMAIN=your-reserved-domain.ngrok-free.app
# NGROK_ADDR=localhost:3000

# Local/testing only: set true together with NODE_ENV=development to skip MCP tokens. Never enable in production.
APPWEAVE_MCP_LOCAL_TEST_MODE=false
# Optional isolated React/Vite builds. Keep false unless Docker CLI/socket access is intentionally enabled.
APPWEAVE_DOCKER_WORKER=false
# Empty uses a project-only host bind mount. In Compose, use its actual existing volume name.
APPWEAVE_DOCKER_WORKER_VOLUME=
APPWEAVE_DOCKER_WORKER_IMAGE=node:20.15.1-bookworm-slim
