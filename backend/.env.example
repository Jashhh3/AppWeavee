PORT=3000
DATA_FILE=./data/appweave.json
JWT_SECRET=replace-with-a-long-random-secret
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173
PROJECT_WORKSPACE_ROOT=./data/projects

# Required outside tests/local development; use a random 32+ character secret.
AI_ENCRYPTION_KEY=replace-with-a-long-random-encryption-secret

# Session cookie settings
SESSION_COOKIE_NAME=appweave_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_MAX_AGE=604800
