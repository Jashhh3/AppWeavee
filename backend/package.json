    "@types/estree": "^1.0.9",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.12",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
