JWT_SECRET=replace-with-a-long-random-value
AI_ENCRYPTION_KEY=replace-with-a-long-encryption-key
DATA_FILE=./data/appweave.json
# Compose defaults to this local PostgreSQL URL; replace credentials for shared deployments.
DATABASE_URL=postgresql://appweave:appweave-local-only@postgres:5432/appweave
POSTGRES_DB=appweave
POSTGRES_USER=appweave
POSTGRES_PASSWORD=appweave-local-only
VITE_API_URL=http://localhost:3000
AI_PROVIDER_TIMEOUT_MS=120000

# Local/testing only: set true together with NODE_ENV=development to skip MCP tokens. Never enable in production.
APPWEAVE_MCP_LOCAL_TEST_MODE=false
# Optional isolated React/Vite builds (enable with docker-compose.worker.yml).
APPWEAVE_DOCKER_WORKER=false
APPWEAVE_DOCKER_WORKER_VOLUME=appweave-projects
APPWEAVE_DOCKER_WORKER_IMAGE=node:20.15.1-bookworm-slim
